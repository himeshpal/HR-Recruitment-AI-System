# Copy this file to .env (repo root) and fill in your key. Never commit .env.

# --- LLM (Groq, OpenAI-compatible) ---
# Free key: https://console.groq.com
GROQ_API_KEY=your-groq-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
# Check current model IDs at https://console.groq.com/docs/models
LLM_MODEL_LARGE=openai/gpt-oss-120b
LLM_MODEL_SMALL=openai/gpt-oss-20b

# --- Optional: local Ollama instead of Groq (manual switch, no code change) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_LARGE=llama3.1:8b
# LLM_MODEL_SMALL=llama3.1:8b

# --- Backend ---
CORS_ORIGINS=http://localhost:3000
# DATABASE_URL defaults to backend/data/hr.db
